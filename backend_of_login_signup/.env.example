# ─── Database (Neon PostgreSQL) ───────────────────────────
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# ─── Redis (Upstash) ─────────────────────────────────────
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_token"

# ─── Email (Resend - legacy, kept for compatibility) ─────
RESEND_API_KEY="re_your_resend_api_key"

# ─── Email (Gmail / Nodemailer) ──────────────────────────
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your_gmail_app_password"

# ─── JWT / Access Token ─────────────────────────────────
ACCESS_TOKEN_SECRET="generate_a_64_char_minimum_random_secret_here"
ACCESS_TOKEN_ISSUER="coddite-api"
ACCESS_TOKEN_AUDIENCE="coddite-client"
ACCESS_TOKEN_EXPIRES_IN="15m"

# ─── Frontend URL (for CORS) ─────────────────────────────
FRONTEND_URL="http://localhost:5173"

# ─── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV="development"

# ─── Cloudinary (Profile Photo Storage) ──────────────────
# Create a free Cloudinary account at https://cloudinary.com
# Find these values in your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
