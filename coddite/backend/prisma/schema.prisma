generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

// ============================================================================
// Identity and Sessions
// ============================================================================

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

model User {
  id              String     @id @db.Uuid // UUID v7 generated by application
  emailHash       String     @unique // HMAC-SHA256 of normalized email + pepper
  emailCiphertext String // AES-256-GCM of email
  emailKeyId      String // Key ID for rotation (e.g., 'v1')
  passwordHash    String? // argon2id hash, nullable (OTP default)
  role            UserRole   @default(USER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  profile       Profile?
  refreshTokens RefreshToken[]

  @@map("users")
}

model Profile {
  id              String    @id @db.Uuid // UUID v7 generated by application
  userId          String    @unique @db.Uuid
  handle          String    @unique // Case-insensitive unique handle
  handleChangedAt DateTime?
  avatarUrl       String?
  avatarSeed      String?
  bio             String?
  karma           Int       @default(0)
  trustLevel      Int       @default(0) // 0 to 4
  postCount       Int       @default(0)
  commentCount    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  communities      CommunityMember[]
  communitiesOwned Community[]       @relation("CommunityOwner")
  posts            Post[]
  comments         Comment[]
  votes            Vote[]
  bookmarks        Bookmark[]
  reportsSubmitted Report[]   @relation("ReportSubmitter")
  auditActions     AuditLog[] @relation("AuditActor")
  auditTargets     AuditLog[] @relation("AuditTargetProfile")
  notifications    Notification[]
  blocks           UserBlock[] @relation("Blocker")
  blockedBy        UserBlock[] @relation("Blocked")
  notificationPrefs NotificationPreference[]

  @@map("profiles")
}

model RefreshToken {
  id            String    @id @db.Uuid // UUID v7 generated by application
  userId        String    @db.Uuid
  familyId      String    @db.Uuid
  tokenHash     String    @unique // Hash of the opaque token
  expiresAt     DateTime
  revokedAt     DateTime?
  replacedById  String?   @db.Uuid // Self-relation for reuse detection
  userAgentHash String?
  ipHash        String?
  createdAt     DateTime  @default(now())

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken?  @relation("TokenReplacement", fields: [replacedById], references: [id])
  replacing  RefreshToken[] @relation("TokenReplacement")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model BannedIdentity {
  id          String   @id @db.Uuid // UUID v7 generated by application
  emailHash   String   @unique
  reason      String
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@map("banned_identities")
}

// ============================================================================
// Community
// ============================================================================

enum PostingPolicy {
  ANYONE
  MEMBERS
  MODS_ONLY
}

enum CommunityRole {
  MEMBER
  MODERATOR
  OWNER
}

model Community {
  id            String        @id @db.Uuid // UUID v7 generated by application
  slug          String        @unique // Lowercase, URL-safe
  name          String
  description   String
  rulesMarkdown String?
  iconUrl       String?
  bannerUrl     String?
  isPrivate     Boolean       @default(false)
  isNsfw        Boolean       @default(false)
  postingPolicy PostingPolicy @default(ANYONE)
  memberCount   Int           @default(0)
  createdById   String        @db.Uuid
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  createdBy Profile           @relation("CommunityOwner", fields: [createdById], references: [id])
  members   CommunityMember[]
  posts     Post[]
  reports   Report[]

  @@index([memberCount(sort: Desc)])
  @@map("communities")
}

model CommunityMember {
  communityId String        @db.Uuid
  profileId   String        @db.Uuid
  role        CommunityRole @default(MEMBER)
  mutedUntil  DateTime?
  joinedAt    DateTime      @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([communityId, profileId])
  @@index([profileId])
  @@map("community_members")
}

// ============================================================================
// Content
// ============================================================================

enum PostStatus {
  DRAFT
  PUBLISHED
  LOCKED
  HIDDEN
  DELETED
}

model Post {
  id            String                      @id @db.Uuid // UUID v7 generated by application
  communityId   String                      @db.Uuid
  authorId      String                      @db.Uuid
  title         String
  bodyMarkdown  String
  status        PostStatus                  @default(PUBLISHED)
  upvotes       Int                         @default(0)
  downvotes     Int                         @default(0)
  voteScore     Int                         @default(0) // upvotes - downvotes
  commentCount  Int                         @default(0)
  viewCount     Int                         @default(0)
  isNsfw        Boolean                     @default(false)
  isPinned      Boolean                     @default(false)
  toxicityScore Float?
  embedding     Unsupported("vector(768)")?
  searchVector  Unsupported("tsvector")?
  isSolved      Boolean                     @default(false)
  acceptedCommentId String?                 @db.Uuid
  deletedAt     DateTime?
  removedReason String? // Populated if HIDDEN or DELETED by moderation
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  community Community  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author    Profile    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  acceptedComment Comment? @relation("AcceptedAnswer", fields: [acceptedCommentId], references: [id])
  comments  Comment[]
  votes     Vote[]
  tags      PostTag[]
  bookmarks Bookmark[]
  reports   Report[]
  auditLogs AuditLog[]

  @@index([communityId, status, createdAt(sort: Desc)]) // Community Feed
  @@index([communityId, status, voteScore(sort: Desc)]) // Community Hot Feed
  @@index([status, voteScore(sort: Desc)]) // Global Hot Feed
  @@index([authorId]) // Profile Posts
  @@index([searchVector], type: Gin)
  @@map("posts")
}

model Comment {
  id            String    @id @db.Uuid // UUID v7 generated by application
  postId        String    @db.Uuid
  authorId      String    @db.Uuid
  parentId      String?   @db.Uuid
  bodyMarkdown  String
  upvotes       Int       @default(0)
  downvotes     Int       @default(0)
  voteScore     Int       @default(0) // upvotes - downvotes
  isLocked      Boolean   @default(false)
  deletedAt     DateTime?
  removedReason String? // Populated if deleted by moderation
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  Profile   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentThread", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentThread")
  acceptedAnswers Post[] @relation("AcceptedAnswer")
  votes     Vote[]
  reports   Report[]
  auditLogs AuditLog[]

  @@index([postId, parentId, createdAt(sort: Asc)]) // Fetching threads
  @@index([authorId]) // Profile comments
  @@map("comments")
}

model Vote {
  id        String   @id @db.Uuid // UUID v7 generated by application
  profileId String   @db.Uuid
  postId    String?  @db.Uuid
  commentId String?  @db.Uuid
  value     Int      // 1 for upvote, -1 for downvote
  createdAt DateTime @default(now())

  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([profileId, postId])
  @@unique([profileId, commentId])
  @@index([postId])
  @@index([commentId])
  @@map("votes")
}

model Tag {
  id          String   @id @db.Uuid // UUID v7 generated by application
  name        String   @unique // Lowercase
  description String?
  postCount   Int      @default(0)
  createdAt   DateTime @default(now())

  posts PostTag[]

  @@index([postCount(sort: Desc)])
  @@map("tags")
}

model PostTag {
  postId String @db.Uuid
  tagId  String @db.Uuid

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tags")
}

model Bookmark {
  profileId String   @db.Uuid
  postId    String   @db.Uuid
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([profileId, postId])
  @@map("bookmarks")
}

// ============================================================================
// Moderation
// ============================================================================

enum ReportStatus {
  PENDING
  REVIEWED
  ACTIONED
  DISMISSED
}

enum ReportSource {
  USER
  AI_MODERATION
}

model Report {
  id           String       @id @db.Uuid // UUID v7
  reporterId   String?      @db.Uuid     // Nullable for system reports
  source       ReportSource @default(USER)
  targetType   String       // 'POST' or 'COMMENT'
  postId       String?      @db.Uuid
  commentId    String?      @db.Uuid
  communityId  String       @db.Uuid
  reason       String
  details      String?
  status       ReportStatus @default(PENDING)
  resolvedById String?      @db.Uuid
  resolvedAt   DateTime?
  resolution   String?      // 'removed', 'warned', 'dismissed', etc.
  createdAt    DateTime     @default(now())

  reporter  Profile?  @relation("ReportSubmitter", fields: [reporterId], references: [id], onDelete: SetNull)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  post      Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment   Comment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@index([communityId, status])
  @@index([postId])
  @@index([commentId])
  @@index([reporterId])
  @@map("reports")
}

model AuditLog {
  id              String   @id @db.Uuid // UUID v7
  actorId         String   @db.Uuid
  action          String   // 'post.delete', 'comment.delete', 'report.resolve', 'role.assign', etc.
  targetType      String   // 'POST', 'COMMENT', 'REPORT', 'COMMUNITY_MEMBER'
  postId          String?  @db.Uuid
  commentId       String?  @db.Uuid
  reportId        String?  @db.Uuid
  targetProfileId String?  @db.Uuid
  communityId     String?  @db.Uuid
  reason          String?
  metadata        Json?    // Extra context
  createdAt       DateTime @default(now())

  actor         Profile  @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  post          Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  comment       Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  report        Report?  @relation(fields: [reportId], references: [id], onDelete: SetNull)
  targetProfile Profile? @relation("AuditTargetProfile", fields: [targetProfileId], references: [id], onDelete: SetNull)

  @@index([communityId, createdAt(sort: Desc)])
  @@index([actorId])
  @@map("audit_logs")
}

// ============================================================================
// Notifications
// ============================================================================

enum NotificationType {
  NEW_COMMENT
  NEW_REPLY
  ANSWER_ACCEPTED
  POST_REMOVED
  KARMA_MILESTONE
}

model Notification {
  id        String           @id @db.Uuid // UUID v7
  profileId String           @db.Uuid
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  linkUrl   String?
  createdAt DateTime         @default(now())

  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, isRead])
  @@map("notifications")
}

// ============================================================================
// Blocks and Preferences
// ============================================================================

model UserBlock {
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())

  blocker Profile @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Profile @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@map("user_blocks")
}

model NotificationPreference {
  profileId String           @db.Uuid
  type      NotificationType
  enabled   Boolean          @default(true)
  updatedAt DateTime         @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, type])
  @@map("notification_preferences")
}

