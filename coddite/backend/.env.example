# =============================================================================
# Coddite Backend — .env.example
# This file documents EVERY backend environment variable.
# Copy to .env and fill in values. NEVER commit the actual .env file.
# Used by both the API (server.js) and the worker (worker.js).
# =============================================================================

# ── A. Core Application ──
NODE_ENV=development                  # development | test | production
APP_NAME=Coddite                      # Display name in emails and UI
PORT=4000                              # API listen port
LOG_LEVEL=debug                        # Pino level: trace | debug | info | warn | error | fatal
API_BASE_URL=http://localhost:4000     # Public URL of this API
WEB_BASE_URL=http://localhost:5173     # Public URL of the web app
CORS_ALLOWED_ORIGINS=http://localhost:5173  # Comma-separated exact origins
TRUST_PROXY=0                          # Number of proxy hops (0 locally, 1+ behind LB)
RUN_WORKER_IN_API=true                 # When true, API process also runs BullMQ processors

# ── B. Database ──
# Local Docker: postgresql://coddite:coddite_local_dev@localhost:5432/coddite
# Production (Neon): use the POOLED connection string
DATABASE_URL=postgresql://coddite:coddite_local_dev@localhost:5432/coddite
# Direct (non-pooled) string for Prisma migrations
# Production (Neon): use the DIRECT (non-pooled) connection string
DIRECT_URL=postgresql://coddite:coddite_local_dev@localhost:5432/coddite
DATABASE_POOL_MAX=10                   # Max connection pool size

# ── C. Redis ──
# TCP Redis for BullMQ queues and Socket.IO adapter
# Local Docker: redis://localhost:6379
# Production: Redis Cloud standard TCP connection (noeviction policy required!)
REDIS_URL=redis://localhost:6379
# Optional: separate TCP Redis for caching (falls back to REDIS_URL if empty)
CACHE_REDIS_URL=
# Optional: Upstash REST for cache/rate-limits (production only)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=              # SECRET — get from Upstash dashboard

# ── D. Authentication & Cryptography ──
# Generate all of these with: pnpm secrets:generate
# NEVER reuse production secrets locally!
JWT_ACCESS_SECRET=<generate-with-pnpm-secrets:generate>   # 64 random bytes, base64
JWT_REFRESH_SECRET=<generate-with-pnpm-secrets:generate>  # 64 random bytes, base64 (DIFFERENT from access)
ACCESS_TOKEN_TTL=15m                   # Access token lifetime (e.g. 15m, 1h)
REFRESH_TOKEN_TTL=30d                  # Refresh token lifetime (e.g. 7d, 30d)
COOKIE_DOMAIN=                         # Empty locally; parent domain in production
COOKIE_SECURE=false                    # MUST be true in production
COOKIE_SAMESITE=lax                    # lax (same-site) or none (cross-site fallback)
EMAIL_HASH_PEPPER=<generate-with-pnpm-secrets:generate>   # 32+ random bytes, base64
EMAIL_ENCRYPTION_KEY=<generate-with-pnpm-secrets:generate> # Exactly 32 bytes, base64
EMAIL_ENCRYPTION_KEY_ID=v1             # Key ID for rotation
OTP_HMAC_SECRET=<generate-with-pnpm-secrets:generate>     # 32+ random bytes, base64
IP_HASH_SALT=<generate-with-pnpm-secrets:generate>        # 32+ random bytes, base64
# ── G. Bot Protection (Cloudflare Turnstile) ──
# (Turnstile is not yet implemented in backend/frontend. Placeholders removed to avoid confusion.)

# ── E. Email ──
EMAIL_PROVIDER=smtp                    # resend | smtp
RESEND_API_KEY=                        # SECRET — get from Resend dashboard (production)
EMAIL_FROM=Coddite <noreply@example.test>  # Verified sender address
# SMTP settings (local mail catcher: Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# ── F. Image Storage ──
STORAGE_PROVIDER=cloudinary            # cloudinary | s3 | r2 | local
CLOUDINARY_CLOUD_NAME=                 # Public identifier — get from Cloudinary dashboard
CLOUDINARY_API_KEY=                    # API key — get from Cloudinary dashboard
CLOUDINARY_API_SECRET=                 # SECRET — get from Cloudinary dashboard
UPLOAD_MAX_BYTES=5242880               # 5 MB default
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/gif,image/webp,image/avif

# ── H. AI/ML ──
AI_ENABLED=false                       # Master switch for all AI features
TOXICITY_PROVIDER=heuristic            # heuristic | gemini | openai | local-onnx
EMBEDDING_PROVIDER=heuristic           # heuristic | gemini | openai | local-onnx
TAGGING_PROVIDER=heuristic             # heuristic | gemini | openai
LLM_PROVIDER=                          # gemini | openai (for LLM-backed tasks)
GEMINI_API_KEY=                        # SECRET — get from Google AI Studio
OPENAI_API_KEY=                        # SECRET — get from OpenAI dashboard
EMBEDDING_MODEL=                       # Model identifier (e.g. text-embedding-004)
EMBEDDING_DIMENSIONS=768               # Integer — MUST match the vector(n) column!
TOXICITY_AUTO_HIDE_THRESHOLD=0.85      # Score >= this → auto-hide + review
TOXICITY_REVIEW_THRESHOLD=0.5          # Score >= this → queue for moderators
SIMILARITY_THRESHOLD=0.8               # Cosine similarity for "similar question"
AI_DAILY_BUDGET_CALLS=1000             # Hard cap on paid API calls per day

# ── I. Observability (Sentry) ──
SENTRY_DSN=                            # Backend DSN — get from Sentry dashboard
SENTRY_ENVIRONMENT=development         # Environment tag
SENTRY_TRACES_SAMPLE_RATE=0.1          # 0.0 to 1.0

# ── J. Rate Limiting & Abuse Controls ──
RL_GLOBAL_PER_MIN=300                  # Requests per IP per minute
RL_AUTH_PER_15MIN=20                   # Auth attempts per IP per 15 minutes
RL_SIGNUP_PER_DAY_PER_IP=5             # Signup cap per IP per day
RL_POST_PER_HOUR_NEW_USER=3            # Post cap for trust level 0 accounts
RL_VOTE_PER_MIN=60                     # Vote cap per profile per minute
NEW_ACCOUNT_KARMA_LINK_THRESHOLD=10    # Karma needed to post links/images

# ── K. Bootstrap ──
ADMIN_BOOTSTRAP_EMAIL=                 # Email that receives admin role on first login (one-time)

# ── L. Optional Social Login (feature-flagged) ──
GOOGLE_OAUTH_ENABLED=false             # Feature flag
GOOGLE_CLIENT_ID=                      # Public client ID — get from Google Cloud Console
GOOGLE_CLIENT_SECRET=                  # SECRET — get from Google Cloud Console
