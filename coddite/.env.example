# =============================================================================
# Coddite — Root .env.example
# Used ONLY by docker-compose.yml for local development services.
# Copy to .env and fill in values. NEVER commit the actual .env file.
# =============================================================================

# ── PostgreSQL (local Docker) ──
POSTGRES_USER=coddite
POSTGRES_PASSWORD=coddite_local_dev
POSTGRES_DB=coddite
POSTGRES_PORT=5432

# ── Redis (local Docker) ──
REDIS_PORT=6379

# ── Mailpit (local mail catcher) ──
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
