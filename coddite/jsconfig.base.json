{
  "compilerOptions": {
    "checkJs": true,
    "strict": true,
    "target": "ES2024",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false
  }
}
