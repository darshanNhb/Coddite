# =============================================================================
# Coddite Frontend — .env.example
# PUBLIC values only! Everything prefixed with VITE_ is embedded in the
# JavaScript bundle and visible to every visitor.
# A secret MUST NEVER have a VITE_ prefix.
# Copy to .env and fill in values. NEVER commit the actual .env file.
# =============================================================================

VITE_API_BASE_URL=http://localhost:4000           # API URL
VITE_WS_URL=http://localhost:4000                 # Socket.IO URL
VITE_SENTRY_DSN=                                  # Public frontend Sentry DSN
VITE_GOOGLE_CLIENT_ID=                            # Public Google client ID (if Google login is on)
VITE_APP_ENV=development                          # Environment label
